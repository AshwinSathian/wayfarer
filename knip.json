{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/sw.ts",
        "src/**/*.worker.ts",
        "src/**/*.spec.ts",
        "src/testing/**/*.ts",
        "e2e/**/*.{ts,mjs}",
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "src/design-system/**/*.css",
        "e2e/**/*.{ts,mjs}",
        "scripts/**/*.mjs"
      ],
      "ignoreDependencies": [
        "@angular/language-service",
        "chai",
        "crypto-js",
        "lodash",
        "moment",
        "uuid"
      ],
      "ignoreBinaries": [
        "wayfarer-cli"
      ]
    },
    "packages/bridge": {
      "entry": [
        "bin/*.js",
        "test/*.js"
      ],
      "project": [
        "**/*.js"
      ]
    },
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@stryker-mutator/command-runner"
      ],
      "ignoreBinaries": [
        "xmllint"
      ]
    },
    "packages/cli": {
      "entry": [
        "src/main.ts",
        "test/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs",
        "test/*.mjs"
      ],
      "ignoreDependencies": [
        "@wayfarer/core"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}

---
// "Moving from Postman" (W2.3): the steps, in the order they are done, then what does not come across, and how to go
// back. Every step names its claims, or Postman's own page for what is done in Postman.
import Base from "../../../layouts/Base.astro";
import Claims from "../../../components/Claims.astro";
import CompareClose from "../../../components/CompareClose.astro";
import Rich from "../../../components/Rich.astro";
import { SITE } from "../../../lib/meta";
import type { Rich as RichText, Source } from "../../../lib/rivals";

const POSTMAN_EXPORT: Source = {
  title: "Postman docs: Export data",
  url: "https://learning.postman.com/docs/getting-started/importing-and-exporting/exporting-data/",
  read: "2026-11-04",
};
const BENCHMARK: Source = {
  title: "Wayfarer benchmark, task 2, with its recording",
  url: `${SITE}/docs/benchmark/#wayfarer-measured`,
  read: "2026-11-05",
};

const STEPS: [string, RichText][] = [
  [
    "Export from Postman",
    [
      "For each collection: Collections, the collection's View more actions menu, More, Export collection, then Export JSON. For an environment, its View more actions menu and Export; for globals, the Variables pane, Globals, Export. ",
      { cite: POSTMAN_EXPORT },
    ],
  ],
  [
    "Import the collection",
    [
      "In Wayfarer's sidebar, Import… (with collections there already, Import, then File…), and choose the file. You see what it will add, and what of it could not be kept, before anything is stored. ",
      { claims: ["C-054", "C-058"] },
    ],
  ],
  [
    "Import the environments",
    ["In Environments, Import environments, and choose the environment or globals file. ", { claims: ["C-058"] }],
  ],
  [
    "Read the scripts",
    [
      "A collection's scripts from a file wait until you have read them and said you trust them: in the import's report, Import and review scripts…, then Trust these scripts. ",
      { claims: ["C-051"] },
    ],
  ],
  [
    "Check what scripts call",
    [
      "The parts of ",
      { code: "pm" },
      " that Wayfarer has are listed in the ",
      { a: "compatibility document", href: "/docs/postman-compatibility/" },
      "; a part it does not have throws an error that names it. ",
      { claims: ["C-040"] },
    ],
  ],
  [
    "Put secrets in the vault",
    [
      "Mark a variable that holds a token or a password as a secret: its value is then stored only as ciphertext. ",
      { claims: ["C-003"] },
    ],
  ],
  [
    "Run it in CI",
    [
      "Where Newman ran the collection, ",
      { code: "npx wayfarer-cli run collection.json -e environment.json --allow-scripts --reporter cli,junit" },
      " runs it with the app's engine, to the results the app gives. ",
      { claims: ["C-065"] },
      " See ",
      { a: "the command line", href: "/docs/cli/" },
      ".",
    ],
  ],
];
const H2 = "type-site-title-2 font-semibold text-ink md:type-site-title-1";
const LIST = "mt-6 list-disc space-y-4 pl-5 marker:text-ink-muted";
---

<Base
  path="/compare/moving-from-postman/"
  title="Move from Postman to Wayfarer: collections, scripts and CI"
  description="Export from Postman, import into Wayfarer, review the scripts, run the collection in CI. What comes across, what does not, and how to go back."
>
  <main id="main">
    <div class="frame pt-16 sm:pt-24">
      <header class="col">
        <h1 class="type-site-title-1 font-semibold text-ink sm:type-site-display">Moving from Postman</h1>
        <p class="mt-6 type-site-lede text-ink">
          <Rich
            parts={[
              "Export each collection and environment from Postman, import them here, read the scripts, and run the collection. In our scripted benchmark, importing a collection with scripts, trusting them and running it took 7 clicks. ",
              { cite: BENCHMARK },
              " Below are the steps, then what does not come across, and how to go back.",
            ]}
          />
        </p>
      </header>

      <section class="col mt-16 sm:mt-20">
        <h2 id="steps" class={H2}>The steps</h2>
        <ol class="mt-8 list-decimal space-y-10 pl-7 marker:font-semibold marker:text-ink-muted">
          {
            STEPS.map(([title, text]) => (
              <li class="pl-2">
                <h3 class="type-site-title-3 font-semibold text-ink">{title}</h3>
                <p class="mt-2 text-ink-muted">
                  <Rich parts={text} />
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="col mt-20 sm:mt-28">
        <h2 id="not-across" class={H2}>What does not come across</h2>
        <ul class={LIST}>
          <li>
            What the import report lists as not kept: it names each thing, before anything is stored.
            <Claims ids={["C-054"]} />
          </li>
          <li>
            The parts of <code>pm</code> marked not supported in the <a
              class="link"
              href="/docs/postman-compatibility/">compatibility document</a
            >, such as <code>pm.cookies</code>. <Claims ids={["C-040"]} />
          </li>
          <li>
            Requests a browser cannot make (forbidden headers, CORS, relaxed TLS) need the <a
              class="link"
              href="/docs/browser-limits/">Local Bridge</a
            >; the composer says which before you send. <Claims ids={["C-049", "C-064"]} />
          </li>
          <li>
            Shared workspaces: a team shares a collection as a copy, by file or by an encrypted link, and the copies do
            not follow each other's changes. <Claims ids={["C-084"]} /> See <a class="link" href="/docs/sharing/"
              >sharing</a
            > and <a class="link" href="/compare/#behind">where Wayfarer is behind</a>.
          </li>
        </ul>
      </section>

      <section class="col mt-20 sm:mt-28">
        <h2 id="back" class={H2}>Taking it back to Postman</h2>
        <p class="mt-6">
          A collection exports as a Postman Collection v2.1 file, and an environment as a Postman environment file,
          with credentials masked unless you ask for them. <Claims ids={["C-057", "C-014"]} /> See <a
            class="link"
            href="/docs/export/">export</a
          >, and <a class="link" href="/compare/postman/">Wayfarer vs Postman</a> for how the two differ.
        </p>
      </section>
    </div>
    <CompareClose />
  </main>
</Base>

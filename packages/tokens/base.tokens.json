{
  "$description": "Wayfarer's tokens that both themes share. DTCG 2025.10.",
  "$extensions": {
    "com.wayfarer.contrast": {
      "normal": {
        "primary": 15,
        "secondary": 7,
        "tertiary": 4.5,
        "boundary": 3,
        "hairline": 1.25,
        "edge": 1.12,
        "fill-quiet": 1.08,
        "fill": 1.16,
        "hover": 1.22,
        "press": 1.4,
        "selected": 1.3,
        "thumb": 1.6,
        "thumb-hover": 2.4,
        "selection": 1.7,
        "ink-hover": 11,
        "ink-press": 8
      },
      "more": {
        "primary": 17.5,
        "secondary": 10,
        "tertiary": 7,
        "boundary": 4.5,
        "hairline": 1.5,
        "edge": 1.25,
        "fill-quiet": 1.12,
        "fill": 1.25,
        "hover": 1.35,
        "press": 1.6,
        "selected": 1.5,
        "thumb": 2.2,
        "thumb-hover": 3.2,
        "selection": 2,
        "ink-hover": 13,
        "ink-press": 10
      }
    }
  },
  "radius": {
    "$description": "Corner radii, three and a circle (U-126): -xs an inline mark or a keycap, -sm a control, -lg an overlay or a container, -full a pill.",
    "radius-xs": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": {
        "value": 9,
        "unit": "px"
      }
    },
    "radius-full": {
      "$type": "dimension",
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "size": {
    "$description": "Control heights (U-124), in rem so that they grow with the text: -sm a row's inline field or icon, -md a small button and the toolbar's controls, -lg a field, a select and a button.",
    "ctl-height-sm": {
      "$type": "dimension",
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    },
    "ctl-height-md": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "ctl-height-lg": {
      "$type": "dimension",
      "$value": {
        "value": 2.25,
        "unit": "rem"
      }
    }
  },
  "motion": {
    "$description": "Durations and easings: docs/design/motion.md is their spec. No stylesheet writes a duration or an easing of its own (packages/tokens/tokens.test.mjs).",
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": [0.25, 0, 0, 1]
    },
    "ease-enter": {
      "$type": "cubicBezier",
      "$value": [0, 0, 0, 1]
    },
    "dur-micro": {
      "$type": "duration",
      "$value": {
        "value": 60,
        "unit": "ms"
      }
    },
    "dur-quick": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "dur-standard": {
      "$type": "duration",
      "$value": {
        "value": 240,
        "unit": "ms"
      }
    },
    "dur-enter": {
      "$type": "duration",
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "ease-in-out": {
      "$type": "cubicBezier",
      "$value": [0.42, 0, 0.58, 1]
    },
    "ease-linear": {
      "$type": "cubicBezier",
      "$value": [0, 0, 1, 1]
    },
    "dur-pulse": {
      "$type": "duration",
      "$value": {
        "value": 2000,
        "unit": "ms"
      }
    },
    "dur-shimmer": {
      "$type": "duration",
      "$value": {
        "value": 1200,
        "unit": "ms"
      }
    },
    "dur-none": {
      "$type": "duration",
      "$value": {
        "value": 0.001,
        "unit": "ms"
      }
    }
  },
  "font": {
    "$description": "Font families.",
    "font-sans": {
      "$type": "fontFamily",
      "$value": ["Inter Variable", "Inter", "system-ui", "-apple-system", "BlinkMacSystemFont", "sans-serif"]
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "Menlo", "SF Mono", "Consolas", "monospace"]
    }
  },
  "type": {
    "$description": "The app's type scale (D3.2). Nothing is under 12 px; a font size anywhere in the stylesheets reads one of these or is 12 px or more (packages/tokens/tokens.test.mjs). Letter spacing is in px, as DTCG's dimension allows, at each style's own size.",
    "type-title-2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 18,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.252,
          "unit": "px"
        },
        "lineHeight": 1.3333
      }
    },
    "type-title-3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.15,
          "unit": "px"
        },
        "lineHeight": 1.3333
      }
    },
    "type-body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.042,
          "unit": "px"
        },
        "lineHeight": 1.4286
      }
    },
    "type-callout": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 13,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.026,
          "unit": "px"
        },
        "lineHeight": 1.3846
      }
    },
    "type-subhead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1.3333
      }
    },
    "type-footnote": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.024,
          "unit": "px"
        },
        "lineHeight": 1.3333
      }
    },
    "type-overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.72,
          "unit": "px"
        },
        "lineHeight": 1.3333
      },
      "$extensions": {
        "com.wayfarer.css": {
          "text-transform": "uppercase"
        }
      }
    },
    "type-mono-body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-mono}",
        "fontSize": {
          "value": 13,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1.5385
      }
    }
  }
}

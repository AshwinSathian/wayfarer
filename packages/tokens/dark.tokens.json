{
  "$description": "Wayfarer's dark theme: warm graphite, ink for chrome and actions, hue for protocol (methods, statuses) and the route (the brand hue, rationed). DTCG 2025.10; colours in OKLCH. The tokens with a com.wayfarer.derive extension have no hand-set value: packages/tokens/tokens.mjs solves them from this file's inputs and base's contrast targets.",
  "$extensions": {
    "com.wayfarer.inputs": {
      "hue": 84,
      "chroma": 0.01
    }
  },
  "canvas": {
    "$description": "Surfaces, darkest at the sidebar, lightest where a surface floats.",
    "canvas-app": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.196091, 0.004248, 84.5908]
      }
    },
    "canvas-sidebar": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.178407, 0.002613, 67.6588]
      }
    },
    "canvas-panel": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.218127, 0.00414, 84.5884]
      }
    },
    "canvas-elevated": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.247717, 0.005756, 91.5971]
      }
    },
    "canvas-overlay": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.28089, 0.005586, 91.5728]
      }
    }
  },
  "surface": {
    "$description": "Surfaces that float (toolbar, menus, dialogs). Opaque: with no blur behind them, transparency let the page show through (audit U-025). A popup is a step above the dialog it opens in (U-115).",
    "surface-toolbar": {
      "$type": "color",
      "$value": "{canvas.canvas-app}"
    },
    "surface-overlay": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.31, 0.006, 84]
      }
    },
    "surface-dialog": {
      "$type": "color",
      "$value": "{canvas.canvas-overlay}"
    }
  },
  "label": {
    "$description": "Text, in three tiers solved against their contrast targets on every surface (primary on the app's canvas): each tier has less contrast than the one above (U-119).",
    "label-primary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "primary",
          "against": ["canvas-app"]
        }
      }
    },
    "label-secondary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "secondary"
        }
      }
    },
    "label-tertiary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "tertiary"
        }
      }
    }
  },
  "ink": {
    "$description": "Wayfarer acting: Send's fill, the focus ring, the selected row's mark, a checked box. The primary label, and what is written on it.",
    "ink": {
      "$type": "color",
      "$value": "{label.label-primary}"
    },
    "on-ink": {
      "$type": "color",
      "$value": "{canvas.canvas-app}"
    },
    "ink-hover": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "ink-hover",
          "against": ["on-ink"]
        }
      }
    },
    "ink-press": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "ink-press",
          "against": ["on-ink"]
        }
      }
    }
  },
  "control": {
    "$description": "A control's edge, kept apart from the separators: 3:1 on every surface (U-109).",
    "ctl-boundary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "boundary"
        }
      }
    }
  },
  "fill": {
    "$description": "The ink over a surface: a quiet control, a filled one, hover, press and a selected row.",
    "fill-secondary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "fill-quiet",
          "alpha": "{ink.ink}"
        }
      }
    },
    "fill-primary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "fill",
          "alpha": "{ink.ink}"
        }
      }
    },
    "fill-hover": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hover",
          "alpha": "{ink.ink}"
        }
      }
    },
    "fill-active": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "press",
          "alpha": "{ink.ink}"
        }
      }
    },
    "fill-selected": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "selected",
          "alpha": "{ink.ink}"
        }
      }
    }
  },
  "separator": {
    "$description": "Hairlines between areas.",
    "separator": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hairline",
          "alpha": "{ink.ink}"
        }
      }
    },
    "separator-opaque": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hairline"
        }
      }
    }
  },
  "border": {
    "$description": "Edges of floating surfaces: -subtle a top-edge highlight, -strong an outline.",
    "border-subtle": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "edge",
          "alpha": "{ink.ink}"
        }
      }
    },
    "border-strong": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hairline",
          "alpha": "{ink.ink}"
        }
      }
    }
  },
  "status": {
    "$description": "Success, warning and error, the product's own (U-036). The plain colour is for fills, borders and icons; -text is for words. Information has no hue: it is the secondary label with a glyph (in each theme).",
    "status-info-fill": {
      "$type": "color",
      "$value": "{fill.fill-secondary}"
    },
    "status-info-border": {
      "$type": "color",
      "$value": "{border.border-strong}"
    },
    "status-info-text": {
      "$type": "color",
      "$value": "{label.label-secondary}"
    },
    "status-success": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hue",
          "hue": 150,
          "chroma": 0.14
        }
      }
    },
    "status-success-fill": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "copy": "status-success",
          "alpha": 0.1
        }
      }
    },
    "status-success-border": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "copy": "status-success",
          "alpha": 0.28
        }
      }
    },
    "status-warning": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hue",
          "hue": 72,
          "chroma": 0.14
        }
      }
    },
    "status-warning-fill": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "copy": "status-warning",
          "alpha": 0.1
        }
      }
    },
    "status-warning-border": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "copy": "status-warning",
          "alpha": 0.28
        }
      }
    },
    "status-error": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hue",
          "hue": 27,
          "chroma": 0.14
        }
      }
    },
    "status-error-fill": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "copy": "status-error",
          "alpha": 0.1
        }
      }
    },
    "status-error-border": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "copy": "status-error",
          "alpha": 0.28
        }
      }
    },
    "status-success-text": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hue-text",
          "hue": 150,
          "chroma": 0.11,
          "over": ["fill-hover", "fill-selected", "fill-active", "status-success-fill"]
        }
      }
    },
    "status-warning-text": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hue-text",
          "hue": 72,
          "chroma": 0.11,
          "over": ["fill-hover", "fill-selected", "fill-active", "status-warning-fill"]
        }
      }
    },
    "status-error-text": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hue-text",
          "hue": 27,
          "chroma": 0.11,
          "over": ["fill-hover", "fill-selected", "fill-active", "status-error-fill"]
        }
      }
    }
  },
  "method": {
    "$description": "HTTP methods: a hue each, 40 degrees or more from every other family's (the hue-gap test), GET, POST and DELETE kept near their statuses' on purpose. Solved from the hue against the contrast targets: nothing here is hand-set. -text is for words. HEAD is in each theme: it has no hue.",

---
// The claims a sentence makes, each a link to its row of the ledger (docs/claims.md).
interface Props {
  ids: string[];
}
const { ids } = Astro.props;
const LEDGER = "https://github.com/AshwinSathian/wayfarer/blob/main/docs/claims.md";
---

<span class="claims" data-claims={ids.join(" ")}>({ids.map((id, i) => <>{i > 0 && ", "}<a href={LEDGER}>{id}</a></>)})</span>

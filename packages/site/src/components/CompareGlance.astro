---
// Where each product stands on the rows of GLANCE_ROWS: Wayfarer's cells name claims, a rival's cite its own page. A
// table that scrolls sideways in its own box on a narrow window, which a keyboard reaches and a screen reader names.
import { GLANCE_ROWS, WAYFARER_GLANCE, type Rival } from "../lib/rivals";
import Cite from "./Cite.astro";
import Rich from "./Rich.astro";

interface Props {
  rivals: Rival[];
  label: string;
}
const { rivals, label } = Astro.props;
// With every rival, a cell keeps a readable measure and the table scrolls instead.
const many = rivals.length > 1;
---

{many && <p class="compare-hint col-wide mt-6 text-ink-muted type-site-caption">The table scrolls sideways.</p>}
<div class="compare-scroll col-wide mt-8" role="region" aria-label={label} tabindex="0">
  <!-- Below 48 em a wide table is one block for each question, a line for each product (loupe, 3.5.0: on a phone only the
       first product showed, with 170 px of blank under it). The roles keep a table a table where display: block drops it. -->
  <table role="table" class:list={["compare-table", many ? "compare-stack [&_td]:min-w-44" : "w-full max-w-5xl"]}>
    <thead role="rowgroup">
      <tr role="row">
        <th role="columnheader" scope="col"><span class="sr-only">Question</span></th>
        <th role="columnheader" scope="col">Wayfarer</th>
        {rivals.map((rival) => <th role="columnheader" scope="col">{rival.name}</th>)}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        GLANCE_ROWS.map(([row, question]) => (
          <tr role="row">
            <th role="rowheader" scope="row">{question}</th>
            <td role="cell" data-label="Wayfarer">
              <Rich parts={WAYFARER_GLANCE[row]} />
            </td>
            {rivals.map((rival) => {
              const fact = rival.glance[row];
              return fact ? (
                <td role="cell" data-label={rival.name}>
                  {fact.text} <Cite source={fact.source} />
                </td>
              ) : (
                <td role="cell" data-label={rival.name} class="text-ink-muted">Not documented</td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

---
import { getCollection } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { titleOf } from "../../docs";

const docs = (await getCollection("docs")).map((doc) => ({ id: doc.id, title: titleOf(doc) })).sort((a, b) => a.title.localeCompare(b.title));
---

<Docs title="Docs: Wayfarer" description="Wayfarer's documentation: variables, auth, scripts, import and export, the vault, storage, the Local Bridge, the command line and the claims ledger.">
  <h1>Docs</h1>
  <ul class="doc-list">
    {docs.map((doc) => <li><a href={`/docs/${doc.id}/`}>{doc.title}</a></li>)}
  </ul>
</Docs>

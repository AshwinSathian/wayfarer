    "fill-active": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "press",
          "alpha": "{ink.ink}"
        }
      }
    },
    "fill-selected": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "selected",
          "alpha": "{ink.ink}"
        }
      }
    }
  },
  "separator": {
    "$description": "Hairlines between areas.",
    "separator": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {

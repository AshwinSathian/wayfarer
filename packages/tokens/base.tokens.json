  "site-type": {
    "$description": "The site's type scale (D3.2's second scale, W5.1): the app's face at the sizes a page that is read, not worked in, needs. In rem, as the app's; nothing under 12 px. Written into packages/site as Tailwind utilities (`type-site-body`), so that a breakpoint can change a size (`md:type-site-display`). Titles are 700: the site loads Atkinson Hyperlegible Next at 400 and 700 only.",
    "type-site-display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 3.5,
          "unit": "rem"

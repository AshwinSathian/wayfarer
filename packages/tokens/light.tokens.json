{
  "$description": "Wayfarer's light theme: warm graphite, ink for chrome and actions, hue for protocol only (DQ11). DTCG 2025.10; colours in OKLCH. The tokens with a com.wayfarer.derive extension have no hand-set value: packages/tokens/tokens.mjs solves them from this file's inputs and base's contrast targets.",
  "$extensions": {
    "com.wayfarer.inputs": {
      "hue": 84,
      "chroma": 0.01
    }
  },
  "canvas": {
    "$description": "Surfaces, darkest at the sidebar, lightest where a surface floats.",
    "canvas-app": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.98531, 0.002856, 84.5588]
      }
    },
    "canvas-sidebar": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.964085, 0.004128, 91.4467]
      }
    },
    "canvas-panel": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [1, 0, "none"]
      }
    },
    "canvas-elevated": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.970082, 0.004122, 91.4464]
      }
    },
    "canvas-overlay": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [1, 0, "none"]
      }
    }
  },
  "surface": {
    "$description": "Surfaces that float (toolbar, menus, dialogs). Opaque: with no blur behind them, transparency let the page show through (audit U-025). A popup is a step above the dialog it opens in (U-115).",
    "surface-toolbar": {
      "$type": "color",
      "$value": "{canvas.canvas-app}"
    },
    "surface-overlay": {
      "$type": "color",
      "$value": "{canvas.canvas-panel}"
    },
    "surface-dialog": {
      "$type": "color",
      "$value": "{canvas.canvas-overlay}"
    }
  },
  "label": {
    "$description": "Text, in three tiers solved against their contrast targets on every surface (primary on the app's canvas): each tier has less contrast than the one above (U-119).",
    "label-primary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "primary",
          "against": ["canvas-app"]
        }
      }
    },
    "label-secondary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "secondary"
        }
      }
    },
    "label-tertiary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "tertiary"
        }
      }
    }
  },
  "ink": {
    "$description": "Wayfarer acting: Send's fill, the focus ring, the selected row's mark, a checked box. The primary label, and what is written on it.",
    "ink": {
      "$type": "color",
      "$value": "{label.label-primary}"
    },
    "on-ink": {
      "$type": "color",
      "$value": "{canvas.canvas-panel}"
    },
    "ink-hover": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "ink-hover",
          "against": ["on-ink"]
        }
      }
    },
    "ink-press": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "ink-press",
          "against": ["on-ink"]
        }
      }
    }
  },
  "control": {
    "$description": "A control's edge, kept apart from the separators: 3:1 on every surface (U-109).",
    "ctl-boundary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "boundary"
        }
      }
    }
  },
  "fill": {
    "$description": "The ink over a surface: a quiet control, a filled one, hover, press and a selected row.",
    "fill-secondary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "fill-quiet",
          "alpha": "{ink.ink}"
        }
      }
    },
    "fill-primary": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "fill",
          "alpha": "{ink.ink}"
        }
      }
    },
    "fill-hover": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hover",
          "alpha": "{ink.ink}"
        }
      }

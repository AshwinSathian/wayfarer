{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "wayfarer": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/wayfarer"
            },
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "THIRD_PARTY_NOTICES.md",
                "input": ".",
                "output": "/"
              }
            ],
            "styles": [
              "src/design-system/material-theme.scss",
              "src/styles.css",
              {
                "input": "node_modules/monaco-editor/min/vs/editor/editor.main.css",
                "bundleName": "monaco",
                "inject": false
              }
            ],
            "scripts": [],
            "browser": "src/main.ts",
            "loader": {
              ".ttf": "file"
            },
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1213kb",
                  "maximumError": "1271kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true,
              "namedChunks": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "wayfarer:build:development"
          },
          "configurations": {
            "production": {
              "buildTarget": "wayfarer:build:production"
            },
            "development": {
              "buildTarget": "wayfarer:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "wayfarer:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "wayfarer:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "providersFile": "src/testing/vitest-providers.ts",
            "runnerConfig": "vitest.config.mts",
            "isolate": true,
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageReporters": ["text-summary", "json-summary"],
            "coverageThresholds": {
              "lines": 70
            },
            "browsers": ["ChromiumHeadless"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "e2e/**/*.ts",
              "playwright.config.ts"
            ]
          }
        }
      }
    }
  }
}

---
import { REPO } from "../lib/content";
import Mark from "./Mark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const LINKS = [
  ["Docs", "/docs/"],
  ["Compare", "/compare/"],
  ["Trust", "/docs/trust-center/"],
  ["Changelog", "/changelog/"],
  ["GitHub", REPO],
] as const;
const here = Astro.url.pathname;
// The site's header: the name, the pages a reader looks for, the theme, and the app, on the page's own ground. Below
// 1024 px the pages and the theme fold into a menu, and below 416 px the name is the mark alone, so that "Open
// Wayfarer" keeps to one line at 320 px.
const current = (href: string) => href.startsWith("/") && href !== "/" && here.startsWith(href);
---

<header class="site-header">
  <a href="#main" class="skip btn">Skip to content</a>
  <div class="frame flex h-16 items-center gap-3 sm:gap-8">
    <a href="/" class="flex min-w-0 items-center gap-2.5 type-site-title-3 text-ink no-underline">
      <Mark class="size-7" />
      <span class="max-[26em]:sr-only">Wayfarer</span>
    </a>
    <nav aria-label="Site" class="hidden gap-7 type-site-small lg:flex">
      {
        LINKS.map(([name, href]) => (
          <a href={href} class="link-quiet text-ink" aria-current={current(href) ? "page" : undefined}>
            {name}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <details class="menu lg:hidden">
        <summary class="type-site-small">Menu</summary>
        <nav aria-label="Site" class="menu-panel flex flex-col type-site-small">
          {
            LINKS.map(([name, href]) => (
              <a href={href} class="rounded-sm px-3 py-2 text-ink no-underline hover:bg-paper-sunk">
                {name}
              </a>
            ))
          }
          <ThemeToggle labelled />
        </nav>
      </details>
      <span class="hidden lg:block"><ThemeToggle /></span>
      <a href="/app/" class="btn type-site-small px-3 sm:px-4">Open Wayfarer</a>
    </div>
  </div>
</header>

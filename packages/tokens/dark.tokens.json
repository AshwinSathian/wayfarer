  "scrollbar": {
    "$description": "The scrollbar's thumb.",
    "scrollbar-thumb": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "thumb",
          "alpha": "{ink.ink}"
        }
      }
    },
    "scrollbar-thumb-hover": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "thumb-hover",
          "alpha": "{ink.ink}"
        }
      }
    }
  },
  "selection": {

{
  "$description": "Wayfarer's tokens that both themes share. DTCG 2025.10.",
  "$extensions": {
    "com.wayfarer.contrast": {
      "normal": {
        "primary": 15,
        "secondary": 7,
        "tertiary": 4.5,
        "boundary": 3,
        "hairline": 1.25,
        "edge": 1.12,
        "fill-quiet": 1.08,
        "fill": 1.16,
        "hover": 1.22,
        "press": 1.4,
        "selected": 1.3,
        "thumb": 1.6,
        "thumb-hover": 2.4,
        "selection": 1.7,
        "ink-hover": 11,
        "ink-press": 8
      },
      "more": {
        "primary": 17.5,
        "secondary": 10,
        "tertiary": 7,
        "boundary": 4.5,
        "hairline": 1.5,
        "edge": 1.25,
        "fill-quiet": 1.12,
        "fill": 1.25,
        "hover": 1.35,
        "press": 1.6,
        "selected": 1.5,
        "thumb": 2.2,
        "thumb-hover": 3.2,
        "selection": 2,
        "ink-hover": 13,
        "ink-press": 10
      }
    }
  },
  "radius": {
    "$description": "Corner radii, three and a circle (U-126): -xs an inline mark or a keycap, -sm a control, -lg an overlay or a container, -full a pill.",
    "radius-xs": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": {
        "value": 9,
        "unit": "px"
      }
    },
    "radius-full": {
      "$type": "dimension",
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "size": {
    "$description": "Control heights (U-124), in rem so that they grow with the text: -sm a row's inline field or icon, -md a small button and the toolbar's controls, -lg a field, a select and a button.",
    "ctl-height-sm": {
      "$type": "dimension",
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    },
    "ctl-height-md": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "ctl-height-lg": {
      "$type": "dimension",
      "$value": {
        "value": 2.25,
        "unit": "rem"
      }
    }
  },
  "motion": {
    "$description": "Durations and easings: docs/design/motion.md is their spec. No stylesheet writes a duration or an easing of its own (packages/tokens/tokens.test.mjs).",
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": [0.25, 0, 0, 1]
    },
    "ease-enter": {
      "$type": "cubicBezier",
      "$value": [0, 0, 0, 1]
    },
    "dur-micro": {
      "$type": "duration",
      "$value": {
        "value": 60,
        "unit": "ms"
      }
    },
    "dur-quick": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "dur-standard": {
      "$type": "duration",
      "$value": {
        "value": 240,
        "unit": "ms"
      }
    },
    "dur-enter": {
      "$type": "duration",
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "ease-in-out": {
      "$type": "cubicBezier",
      "$value": [0.42, 0, 0.58, 1]
    },
    "ease-linear": {
      "$type": "cubicBezier",
      "$value": [0, 0, 1, 1]
    },
    "dur-pulse": {
      "$type": "duration",
      "$value": {
        "value": 2000,
        "unit": "ms"
      }
    },
    "dur-shimmer": {
      "$type": "duration",
      "$value": {
        "value": 1200,
        "unit": "ms"
      }
    },
    "dur-none": {
      "$type": "duration",
      "$value": {
        "value": 0.001,
        "unit": "ms"
      }
    }
  },
  "font": {
    "$description": "Font families (DQ11). Atkinson Hyperlegible Next speaks for Wayfarer: its I, l and 1, and its 0 and O, differ at 12 and 13 px (U-150). It has Latin only; Inter is the per-glyph fallback for Greek, Cyrillic and Vietnamese. JetBrains Mono is the wire.",
    "font-sans": {
      "$type": "fontFamily",
      "$value": [
        "Atkinson Hyperlegible Next",
        "Inter Variable",
        "Inter",
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "sans-serif"
      ]
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "Menlo", "SF Mono", "Consolas", "monospace"]
    }
  },
  "type": {
    "$description": "The app's type scale (D3.2), in rem so that it follows the reader's text size (U-073). Nothing is under 12 px at the default size; no stylesheet writes a font size in px (packages/tokens/tokens.test.mjs). The compact density (U-111): working text (values, rows, tabs, the response) is callout or mono-body, 13 px; captions footnote, 12 px; prose and dialogs body, 14 px.",
    "type-title-2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.font-sans}",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        },
        "lineHeight": 1.3333
      }
    },
    "type-title-3": {

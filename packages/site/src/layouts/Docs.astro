---
// The docs' layout (W2.2): the site's page with the search, which is the one script of the site
// (Pagefind, from its own files; /docs/* has a CSP of its own, security/csp-docs.json).
import Header from "../components/Header.astro";
import Page from "./Page.astro";

interface Props {
  title: string;
  description: string;
  /** More of the site's own scripts, for one page (the claims' CI result). */
  scripts?: string[];
}
const { title, description, scripts = [] } = Astro.props;
---

<Page title={title} description={description}>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <Header />
  <main class="docs">
    <div id="search"></div>
    <slot />
  </main>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline src="/docs-search.js"></script>
  {scripts.map((src) => <script is:inline src={src} />)}
</Page>

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "node"
    ],
    "paths": {
      "@wayfarer/core": [
        "./packages/core/src/index.ts"
      ],
      "@wayfarer/core/library-loader": [
        "./packages/core/src/scripting/library-loader.ts"
      ],
      "@wayfarer/core/pm-compat/*": [
        "./packages/core/test/pm-compat/*"
      ],
      "monaco-editor/editor": [
        "./src/testing/monaco/monaco-editor.api.stub.ts"
      ],
      "monaco-editor/languages/features/*/register": [
        "./src/testing/monaco/contribution.stub.ts"
      ],
      "monaco-editor/languages/definitions/*/register": [
        "./src/testing/monaco/contribution.stub.ts"
      ],
      "monaco-editor/features/*/register": [
        "./src/testing/monaco/contribution.stub.ts"
      ]
    }
  },
  "files": [
    "src/testing/vitest-providers.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}

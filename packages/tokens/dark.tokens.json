  "scrim": {
    "$description": "What dims the page under a modal dialog or a drawer.",
    "scrim": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0, 0, "none"],
        "alpha": 0.55
      }
    }
  },
  "route": {
    "$description": "The brand hue, for where a request goes: the route strip's line, the mark and the selected row's mark. Never a fill of a control, never a link, never Send (which is ink). 40 degrees or more from every method and status hue.",
    "route": {
      "$type": "color",
      "$extensions": {
        "com.wayfarer.derive": {
          "contrast": "hue",
          "hue": 200,
          "chroma": 0.14,
          "over": ["fill-selected", "fill-active"]

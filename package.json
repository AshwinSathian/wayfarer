{
  "name": "wayfarer",
  "version": "1.1.0",
  "description": "A local-first, no-account API client that runs entirely in the browser: collections, environments, an encrypted secrets vault, test assertions, and a response viewer.",
  "license": "MIT",
  "private": true,
  "author": "Ashwin Sathian",
  "homepage": "https://wayfarer.ashwinsathian.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/wayfarer.git"
  },
  "bugs": {
    "url": "https://github.com/AshwinSathian/wayfarer/issues"
  },
  "keywords": [
    "angular",
    "typescript",
    "api-client",
    "api-testing",
    "rest-client",
    "indexeddb",
    "primeng",
    "local-first",
    "developer-tools",
    "http-client"
  ],
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build && node scripts/build-sw.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "bridge": "node local-bridge/bin/cli.js",
    "bridge:test": "node --test local-bridge/test/*.test.js",
    "test:scripts": "node --test e2e/support/*.test.mjs scripts/*.test.mjs",
    "gen:csp": "node scripts/gen-csp.mjs",
    "check:csp": "node scripts/gen-csp.mjs --check",
    "check:claims": "node scripts/check-claims.mjs",
    "bundle:report": "node scripts/bundle-report.mjs dist/wayfarer/browser bundle-report.json --max-initial-gzip=487600"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@primeng/themes": "^21.0.4",
    "idb": "^8.0.3",
    "monaco-editor": "^0.54.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "rxjs": "^7.8.2"
  },
  "//overrides": "TEMPORARY (plan P1.5.2): primeng 21 is the last MIT release and peers on Angular 21 only. These entries let it install on Angular 22 until P1.5.15 removes PrimeNG. Never replace this with primeng 22 (commercial licence).",
  "overrides": {
    "dompurify": "^3.4.12",
    "primeng": {
      "@angular/cdk": "$@angular/cdk",
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/router": "$@angular/router"
    }
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/language-service": "^22.2.1",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.19.1",
    "@vitest/browser-playwright": "^4.1.11",
    "angular-eslint": "22.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "knip": "^6.38.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.112.0"
  }
}

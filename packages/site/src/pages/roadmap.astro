---
// The roadmap (W2.4): the phases and tasks of PLAN-design.md, each done or not, read when the site is built.
import { readFileSync } from "node:fs";
import Header from "../components/Header.astro";
import Page from "../layouts/Page.astro";
import { roadmapOf } from "../roadmap.mjs";

// The build runs in packages/site (`npm -w packages/site run build`).
const phases = roadmapOf(readFileSync("../../PLAN-design.md", "utf8"));
const PLAN = "https://github.com/AshwinSathian/wayfarer/blob/main/PLAN-design.md";
---

<Page title="Roadmap: Wayfarer" description="What is being built next for Wayfarer: the design rebuild, the website and sharing for teams, task by task.">
  <Header />
  <main class="docs">
    <article>
      <h1>Roadmap</h1>
      <p>
        The plan for the design rebuild, this website and sharing for teams, task by task, as <a href={PLAN}>PLAN-design.md</a> has it
        when this page was built.
      </p>
      {
        phases.map((phase) => (
          <section>
            <h2>{phase.title}</h2>
            <ul class="tasks">
              {phase.tasks.map((task) => (
                <li class={task.done ? "task-done" : "task-open"}>
                  <span class="state">{task.done ? "Done" : "To do"}</span> <strong>{task.id}</strong> {task.text}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </article>
  </main>
</Page>
